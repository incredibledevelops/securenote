.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
pyrightconfig.json

# ---------- FastAPI / Uvicorn ----------
*.log
logs/
uvicorn.log

# ---------- Databases / local data ----------
*.db
*.sqlite
*.sqlite3
*.mongo
data/
dump/

# ---------- Jupyter ----------
