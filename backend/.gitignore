.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
.venv/
venv/
ENV/
env/
.env/
.python-version

# ---------- Environment variables (NEVER commit) ----------
.env
.env.*
!.env.example

# ---------- Testing / coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ---------- Type checkers / linters ----------
